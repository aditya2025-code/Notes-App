<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= filename %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { font-family: 'Courier Prime', monospace; }
        .font-display { font-family: 'Special Elite', 'Courier Prime', monospace; }
    </style>
</head>

<body>
    <div class="main w-full min-h-screen bg-[#3B2A1E] p-6 md:p-10"
        style="background-image: repeating-linear-gradient(90deg, rgba(0,0,0,0.12) 0px, rgba(0,0,0,0.12) 1px, transparent 1px, transparent 80px), repeating-linear-gradient(0deg, rgba(0,0,0,0.08) 0px, rgba(0,0,0,0.08) 1px, transparent 1px, transparent 80px);">

        <a class="inline-block mb-8 text-[#C9B79A] hover:text-[#F1E6C9] text-xs tracking-widest" href="/">&laquo; BACK TO CATALOG</a>

        <div class="max-w-2xl mx-auto bg-[#F1E6C9] text-[#2A2118] rounded-sm border border-[#c9bb92] shadow-[8px_8px_0_rgba(0,0,0,0.35)] p-8 md:p-10 rotate-[-0.5deg]">
            <span class="inline-block bg-[#B8934A] text-[#2A2118] text-[10px] px-2 py-0.5 rounded-sm tracking-widest mb-6 shadow-[2px_2px_0_rgba(0,0,0,0.3)]">CASE FILE</span>

            <h1 class="font-display text-3xl md:text-4xl tracking-tighter break-words"><%= filename %></h1>

            <div class="mt-6 pt-6 border-t border-dashed border-[#8a7a54]">
                <p class="text-xl font-light leading-relaxed whitespace-pre-wrap"><%= filedata %></p>
            </div>
        </div>
    </div>
</body>

</html>
